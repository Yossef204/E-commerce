{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*e2e.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/cache-manager|@nestjs/event-emitter|@nestjs/mapped-types|cache-manager)/)"
  ]
}
